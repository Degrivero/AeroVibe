NODE_ENV=production
PORT=3006
BIND_HOST=127.0.0.1

ENABLE_STRIPE=false
ENABLE_MP_CHILE=true
ENABLE_MP_ARG=true

# Stripe (optional if ENABLE_STRIPE=false)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx
STRIPE_PRODUCT_ID=prod_xxx
STRIPE_PORTAL_RETURN_URL=https://aerovibe.app/account

# Mercado Pago
MP_API_BASE=https://api.mercadopago.com
MP_CHILE_ACCESS_TOKEN=APP_USR_xxx
MP_CHILE_WEBHOOK_SECRET=
MP_ARG_ACCESS_TOKEN=APP_USR_xxx
MP_ARG_WEBHOOK_SECRET=

# Base prices in USD
PRO_MONTHLY_USD=4.99
PRO_YEARLY_USD=49.99

# Fallback rates (used only if exchange_rates table has no rows)
USD_RATE_CL=950
USD_RATE_AR=1200

FRONTEND_SUCCESS_URL=https://aerovibe.app/account?checkout=success
FRONTEND_CANCEL_URL=https://aerovibe.app/pricing?checkout=cancel

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx

NATS_URL=nats://localhost:4222

# Optional
CORS_ORIGINS=https://aerovibe.app,https://app.aerovibe.app
SUBSCRIPTIONS_TABLE=user_subscriptions
PAYMENTS_WEBHOOK_EVENTS_TABLE=payments_webhook_events
USER_PROFILES_TABLE=user_profiles
EXCHANGE_RATES_TABLE=exchange_rates
ALLOW_DIRECT_JWT=false
